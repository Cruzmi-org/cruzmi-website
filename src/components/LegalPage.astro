---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { htmlLang, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  page: 'legal' | 'terms' | 'privacy';
}
const { locale, page } = Astro.props;
const tr = t(locale);
const entry = await getEntry('legal', `${locale}/${page}`);
if (!entry) throw new Error(`Missing legal page "${locale}/${page}"`);
const { Content, headings } = await render(entry);
const d = entry.data;

const updated = new Intl.DateTimeFormat(htmlLang[locale], { dateStyle: 'long', timeZone: 'UTC' }).format(d.updated);
const toc = d.toc ? headings.filter((h) => h.depth === 2) : [];
---

<BaseLayout
  locale={locale}
  routeKey={page}
  title={`${d.title} — Cruzmi`}
  description={d.description}
  noindex={!d.reviewed}
>
  <section class="bg-mist">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
      <h1 class="text-5xl leading-[0.95] font-bold sm:text-6xl">{d.title}</h1>
      <p class="mt-4 text-lg text-night/75">
        {tr('legal.updated')}{' '}
        <time datetime={d.updated.toISOString().slice(0, 10)}>{updated}</time>
      </p>
      {
        !d.reviewed && (
          <p role="note" class="mt-6 rounded-xl border-2 border-dashed border-cherry/60 bg-white px-5 py-3 text-lg font-semibold text-cherry">
            {tr('legal.draft')}
          </p>
        )
      }
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
    {
      toc.length > 0 && (
        <nav aria-labelledby="toc-title" class="mb-12 rounded-2xl bg-argile/40 p-6">
          <h2 id="toc-title" class="text-2xl font-bold">
            {tr('legal.toc')}
          </h2>
          <ol class="mt-3 grid gap-x-8 gap-y-1 text-lg sm:grid-cols-2">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-azur underline-offset-2 hover:underline">
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <article class="legal-prose">
      <Content />
    </article>
  </div>
</BaseLayout>
