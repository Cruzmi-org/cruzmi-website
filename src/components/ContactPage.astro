---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { path, type Locale } from '../i18n/config';
import { LIMITS } from '../lib/contact';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const entry = await getEntry('contact', locale);
if (!entry) throw new Error(`Missing contact content for locale "${locale}"`);
const c = entry.data;
const f = c.form;

// Cloudflare's always-pass test key is used until the real one is configured.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';

const field =
  'mt-1 block w-full rounded-xl border border-argile bg-white px-4 py-2.5 text-lg shadow-xs transition focus:border-azur focus:ring-2 focus:ring-azur/30 focus:outline-none user-invalid:border-cherry';
const label = 'block text-lg font-semibold';
const messages = { sending: f.sending, submit: f.submit, ...f.errors };
---

<BaseLayout locale={locale} routeKey="contact" title={c.meta.title} description={c.meta.description}>
  <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <section class="bg-mist">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <h1 class="text-5xl leading-[0.95] font-bold sm:text-6xl">{c.intro.title}</h1>
      <p class="mt-4 max-w-2xl text-xl leading-snug">{c.intro.text}</p>
    </div>
  </section>

  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-14 sm:px-6 lg:grid-cols-[2fr_1fr] lg:px-8 lg:py-20">
    <div>
      <noscript>
        <p class="mb-6 rounded-xl bg-blush/40 px-5 py-4 text-lg">{f.noscript}</p>
      </noscript>

      <form
        id="contact-form"
        method="post"
        action="/api/contact"
        novalidate
        data-messages={JSON.stringify(messages)}
        class="space-y-5"
      >
        <input type="hidden" name="locale" value={locale} />
        <!-- Honeypot: hidden from people and assistive tech, bots tend to fill it. -->
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="firstName" class={label}>{f.firstName}</label>
            <input id="firstName" name="firstName" type="text" required maxlength={LIMITS.name} autocomplete="given-name" class={field} />
          </div>
          <div>
            <label for="lastName" class={label}>{f.lastName}</label>
            <input id="lastName" name="lastName" type="text" required maxlength={LIMITS.name} autocomplete="family-name" class={field} />
          </div>
        </div>

        <div>
          <label for="email" class={label}>{f.email}</label>
          <input id="email" name="email" type="email" required maxlength={LIMITS.email} autocomplete="email" class={field} />
        </div>

        <div>
          <label for="subject" class={label}>{f.subject}</label>
          <select id="subject" name="subject" required class={field}>
            {f.subjectOptions.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        </div>

        <div>
          <label for="message" class={label}>{f.message}</label>
          <textarea
            id="message"
            name="message"
            required
            rows="7"
            minlength={LIMITS.messageMin}
            maxlength={LIMITS.messageMax}
            class={field}></textarea>
        </div>

        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-language={locale} data-theme="light"></div>

        <p class="text-base leading-snug text-night/75">
          {f.privacyBefore}{' '}
          <a href={path(locale, 'privacy')} class="font-semibold text-azur underline underline-offset-2">{f.privacyLink}</a>.
        </p>

        <p id="contact-error" role="alert" class="hidden rounded-xl bg-cherry/10 px-5 py-3 text-lg font-semibold text-cherry"></p>

        <button
          type="submit"
          class="inline-flex items-center gap-2 rounded-full bg-azur px-7 py-3 text-xl font-semibold text-white shadow-sm transition hover:bg-azur-dark disabled:cursor-wait disabled:opacity-70"
        >
          <Icon name="mail" class="size-5" />
          <span data-label>{f.submit}</span>
        </button>
      </form>

      <div id="contact-success" hidden tabindex="-1" class="rounded-3xl bg-sky px-8 py-10 focus:outline-none">
        <Icon name="check" class="size-12 text-azur" />
        <h2 class="mt-3 text-4xl font-bold">{f.success.title}</h2>
        <p class="mt-2 text-xl leading-snug">{f.success.text}</p>
      </div>
    </div>

    <aside class="self-start rounded-3xl bg-argile/50 p-8">
      <h2 class="text-3xl font-bold">{c.aside.title}</h2>
      <ul class="mt-5 space-y-4">
        {
          c.aside.items.map((item) => (
            <li>
              <p class="text-base font-semibold tracking-wide text-azur uppercase">{item.label}</p>
              <a href={`mailto:${item.email}`} class="text-xl font-semibold underline-offset-2 hover:underline">
                {item.email}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</BaseLayout>

<script>
  declare global {
    interface Window {
      turnstile?: { reset: (el?: string | HTMLElement) => void };
    }
  }

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const errorBox = document.querySelector<HTMLElement>('#contact-error');
  const success = document.querySelector<HTMLElement>('#contact-success');

  if (form && errorBox && success) {
    const messages = JSON.parse(form.dataset.messages ?? '{}') as Record<string, string>;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const buttonLabel = button.querySelector<HTMLElement>('[data-label]')!;

    // Pre-select the subject from ?subject=pro (links from the About page).
    const preset = new URLSearchParams(location.search).get('subject');
    const select = form.querySelector<HTMLSelectElement>('#subject');
    if (preset && select && [...select.options].some((o) => o.value === preset)) select.value = preset;

    const showError = (code: string) => {
      errorBox.textContent = messages[code] ?? messages.send;
      errorBox.classList.remove('hidden');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox.classList.add('hidden');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      button.disabled = true;
      buttonLabel.textContent = messages.sending;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (data.ok) {
          form.hidden = true;
          success.hidden = false;
          success.focus();
          return;
        }
        showError(data.error ?? 'send');
      } catch {
        showError('send');
      }
      window.turnstile?.reset();
      button.disabled = false;
      buttonLabel.textContent = messages.submit;
    });
  }
</script>
