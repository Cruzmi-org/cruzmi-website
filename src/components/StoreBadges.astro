---
/**
 * Store buttons. TODO: replace with the official Apple / Google badge artwork (FR + EN variants)
 * before launch — the stores' brand guidelines require their official badges.
 *
 * Below the badges, a short line says where the stores carry the app and links to the install page
 * for everyone else (docs/reste-a-faire.md A7). Drop it (`elsewhere`) once the app is open everywhere.
 */
import Icon from './Icon.astro';
import { path, stores, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  class?: string;
  /** Show the "outside the store countries" line. */
  elsewhere?: boolean;
  /** Background the line sits on: light (azur link) or dark (white link). */
  tone?: 'light' | 'dark';
}
const { locale, class: className = '', elsewhere = true, tone = 'light' } = Astro.props;
const tr = t(locale);
const badges = [
  { href: stores.android[locale], icon: 'play', small: tr('store.android.small'), big: tr('store.android.big') },
  { href: stores.ios[locale], icon: 'apple', small: tr('store.ios.small'), big: tr('store.ios.big') },
] as const;
---

{/* w-fit: the block is as wide as the badges row; the line below wraps to that width (w-0 min-w-full). */}
<div class:list={['w-fit max-w-full', className]}>
  <ul class="flex flex-wrap gap-3">
    {
      badges.map((b) => (
        <li>
          <a
            href={b.href}
            rel="noopener"
            class="flex h-14 min-w-44 items-center gap-3 rounded-xl bg-black px-4 text-white transition hover:bg-night"
          >
            <Icon name={b.icon} class="size-7 shrink-0" />
            <span class="flex flex-col leading-none">
              <span class="text-xs font-semibold uppercase tracking-wide">{b.small}</span>
              <span class="text-2xl font-semibold">{b.big}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  {
    elsewhere && (
      <p class:list={['mt-2 w-0 min-w-full text-base leading-snug', tone === 'dark' ? 'text-white/80' : 'text-night/80']}>
        {tr('store.countries')}{' '}
        <a
          href={path(locale, 'install')}
          class:list={[
            'font-semibold underline underline-offset-2',
            tone === 'dark' ? 'text-white hover:decoration-2' : 'text-azur hover:text-azur-dark',
          ]}
        >
          {tr('store.elsewhere')}
          <span aria-hidden="true">&nbsp;→</span>
        </a>
      </p>
    )
  }
</div>
