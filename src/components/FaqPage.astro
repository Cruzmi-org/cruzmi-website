---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { path, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const entry = await getEntry('faq', locale);
if (!entry) throw new Error(`Missing FAQ content for locale "${locale}"`);
const c = entry.data;

/** Splits a plain-text answer into paragraphs and bullet lists ("• " lines). */
type Block = { kind: 'p'; text: string } | { kind: 'ul'; items: string[] };
function blocks(answer: string): Block[] {
  return answer
    .split(/\n\s*\n/)
    .map((chunk) => chunk.trim())
    .filter(Boolean)
    .map((chunk): Block => {
      const lines = chunk.split('\n').map((l) => l.trim());
      return lines.every((l) => l.startsWith('• '))
        ? { kind: 'ul', items: lines.map((l) => l.slice(2)) }
        : { kind: 'p', text: lines.join(' ') };
    });
}

// schema.org FAQPage structured data (plain text answers).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: locale,
  mainEntity: c.categories.flatMap((cat) =>
    cat.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a.replace(/\n+/g, ' ') },
    })),
  ),
};
---

<BaseLayout locale={locale} routeKey="faq" title={c.meta.title} description={c.meta.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <section class="bg-mist">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:py-20">
      <h1 class="text-5xl leading-[0.95] font-bold sm:text-6xl">{c.intro.title}</h1>
      <p class="mt-4 max-w-2xl text-xl leading-snug">{c.intro.text}</p>
      <nav aria-label={tr('a11y.onThisPage')} class="mt-8">
        <ul class="flex flex-wrap gap-2">
          {
            c.categories.map((cat) => (
              <li>
                <a
                  href={`#${cat.id}`}
                  class="inline-block rounded-full bg-white px-4 py-1.5 text-lg font-semibold ring-1 ring-argile transition hover:bg-azur hover:text-white"
                >
                  {cat.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <div class="mx-auto max-w-4xl space-y-14 px-4 py-14 sm:px-6 lg:py-20">
    {
      c.categories.map((cat) => (
        <section id={cat.id} aria-labelledby={`${cat.id}-title`} class="scroll-mt-24">
          <h2 id={`${cat.id}-title`} class="text-4xl font-bold">
            {cat.title}
          </h2>
          <div class="mt-5 divide-y divide-argile rounded-2xl ring-1 ring-argile">
            {cat.items.map((item) => (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-4 text-xl leading-snug font-semibold transition hover:text-azur [&::-webkit-details-marker]:hidden">
                  <span>{item.q}</span>
                  <Icon name="chevron" class="mt-0.5 size-6 shrink-0 text-azur transition group-open:rotate-180" />
                </summary>
                <div class="space-y-3 px-5 pb-5 text-lg leading-snug">
                  {blocks(item.a).map((b) =>
                    b.kind === 'p' ? (
                      <p>{b.text}</p>
                    ) : (
                      <ul class="list-disc space-y-1 pl-6 marker:text-azur">
                        {b.items.map((li) => (
                          <li>{li}</li>
                        ))}
                      </ul>
                    ),
                  )}
                  {item.link && (
                    <p>
                      <a
                        href={path(locale, item.link.to)}
                        class="font-semibold text-azur underline underline-offset-2 hover:text-azur-dark"
                      >
                        {item.link.label}
                        <span aria-hidden="true">&nbsp;→</span>
                      </a>
                    </p>
                  )}
                </div>
              </details>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <section class="px-4 pb-20 sm:px-6">
    <div
      class="mx-auto flex max-w-4xl flex-col items-start gap-5 rounded-3xl bg-azur px-8 py-10 text-white sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <h2 class="text-4xl font-bold">{c.contact.title}</h2>
        <p class="mt-1 text-xl text-white/90">{c.contact.text}</p>
      </div>
      <a
        href={path(locale, 'contact')}
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-white px-6 py-3 text-xl font-semibold text-azur transition hover:bg-argile"
      >
        <Icon name="mail" class="size-5" />
        {c.contact.button}
      </a>
    </div>
  </section>
</BaseLayout>
