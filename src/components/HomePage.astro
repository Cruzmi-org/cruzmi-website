---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getEntry } from 'astro:content';
import heroPhoto from '../assets/photos/hero-vitaly-gariev-unsplash.jpg';
import printedAlbums from '../assets/photos/printed-albums.jpg';
import { screenshot } from '../assets/screenshots';
import voyages from '../assets/photos/cas-usage/voyages.jpg';
import evenements from '../assets/photos/cas-usage/evenements.jpg';
import associations from '../assets/photos/cas-usage/associations.jpg';
import projets from '../assets/photos/cas-usage/projets.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadCta from './DownloadCta.astro';
import Icon from './Icon.astro';
import StoreBadges from './StoreBadges.astro';
import { path, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const entry = await getEntry('home', locale);
if (!entry) throw new Error(`Missing home content for locale "${locale}"`);
const c = entry.data;

/** Use-case photos, with the crop position that keeps people in the 4:3 card frame. */
const useCasePhotos: Record<(typeof c.useCases.items)[number]['image'], { src: ImageMetadata; position: string }> = {
  voyages: { src: voyages, position: 'object-center' },
  evenements: { src: evenements, position: 'object-center' },
  associations: { src: associations, position: 'object-center' },
  projets: { src: projets, position: 'object-[50%_68%]' },
};

/** Part of each screenshot shown on its benefit card: vertical position of the square crop (skips the project header). */
const benefitCrop: Record<(typeof c.benefits.items)[number]['image'], string> = {
  programme: 'object-[50%_71%]',
  reimbursements: 'object-[50%_28%]',
  shopping: 'object-[50%_71%]',
  gallery: 'object-[50%_88%]',
};
---

<BaseLayout locale={locale} routeKey="home" title={c.meta.title} description={c.meta.description}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-mist">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-12 sm:px-6 lg:grid-cols-2 lg:py-20 lg:px-8">
      <div class="space-y-6">
        <h1 class="text-5xl leading-[0.95] font-bold text-balance sm:text-6xl xl:text-7xl">
          {c.hero.titleBefore}{" "}
          <span class="text-azur italic">{c.hero.titleHighlight}</span>{c.hero.titleAfter}
        </h1>
        <p class="text-2xl leading-tight font-bold sm:text-3xl">{c.hero.subtitle}</p>
        <p class="max-w-xl text-xl leading-snug">{c.hero.lead}</p>
        <div class="space-y-3">
          <StoreBadges locale={locale} />
          <p class="text-lg font-semibold text-azur">{c.hero.reassurance}</p>
        </div>
        <p class="text-2xl font-semibold text-azur italic">
          <span class="decoration-blush underline decoration-4 underline-offset-8">{c.hero.tagline}</span>
        </p>
      </div>
      <Image
        src={heroPhoto}
        alt={c.hero.imageAlt}
        width={1920}
        widths={[640, 960, 1280, 1600, 1920]}
        sizes="(min-width: 1280px) 608px, (min-width: 1024px) 46vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full rounded-3xl object-cover shadow-sm"
      />
    </div>
  </section>

  <!-- Pillars -->
  <section class="relative z-10 px-4 sm:px-6 lg:px-8">
    <ul
      class="mx-auto -mt-6 grid max-w-7xl gap-px overflow-hidden rounded-3xl bg-argile shadow-sm ring-1 ring-argile sm:grid-cols-2 lg:-mt-10 lg:grid-cols-4"
    >
      {
        c.pillars.map((p) => (
          <li class="flex flex-col items-center gap-2 bg-sky px-6 py-7 text-center">
            <Icon name={p.icon} class="size-11 text-azur" />
            <h2 class="text-2xl font-bold">{p.title}</h2>
            <p class="text-lg leading-snug">{p.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Benefits: what Cruzmi does for the group, shown with real app screenshots -->
  <section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8 lg:pt-24">
    <h2 class="max-w-3xl text-4xl leading-none font-bold text-balance sm:text-5xl">{c.benefits.title}</h2>
    <p class="mt-3 max-w-2xl text-xl">{c.benefits.intro}</p>
    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {
        c.benefits.items.map((b) => (
          <li class="flex flex-col overflow-hidden rounded-3xl bg-mist ring-1 ring-argile">
            <div class="space-y-2 p-7 pb-6">
              <h3 class="text-3xl leading-tight font-bold">{b.title}</h3>
              <p class="text-lg leading-snug">{b.text}</p>
            </div>
            <div class="relative mt-auto px-7">
              <Image
                src={screenshot(locale, b.image)}
                alt=""
                widths={[360, 720]}
                sizes="(min-width: 768px) 360px, 80vw"
                class:list={[
                  'mx-auto aspect-square w-full max-w-90 rounded-t-3xl object-cover shadow-lg ring-1 ring-argile',
                  benefitCrop[b.image],
                ]}
              />
              {b.image === 'gallery' && (
                <Image
                  src={printedAlbums}
                  alt=""
                  widths={[160, 320]}
                  sizes="160px"
                  class="absolute right-4 bottom-6 aspect-square w-32 rounded-2xl object-cover shadow-xl ring-4 ring-white sm:right-8 sm:w-40"
                />
              )}
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-center">
      <a
        href={path(locale, 'features')}
        class="inline-flex items-center gap-2 text-xl font-bold text-azur underline decoration-blush decoration-2 underline-offset-4 hover:decoration-azur"
      >
        {c.benefits.link}<span aria-hidden="true">→</span>
      </a>
    </p>
  </section>

  <!-- Use cases -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <h2 class="max-w-xl text-4xl leading-none font-bold sm:text-5xl">{c.useCases.title}</h2>
    <!-- Mobile: full-bleed scroller with the next card peeking, plus position dots. Desktop: grid. -->
    <ul
      data-carousel
      class="-mx-4 mt-10 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-4 sm:-mx-6 sm:scroll-px-6 sm:px-6 md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 lg:grid-cols-4"
    >
      {
        c.useCases.items.map((u) => (
          <li class="w-[80%] shrink-0 snap-start overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-argile sm:w-72 md:w-auto">
            <Image
              src={useCasePhotos[u.image].src}
              alt=""
              widths={[400, 800]}
              sizes="(min-width: 1024px) 296px, (min-width: 768px) 45vw, 80vw"
              class:list={['aspect-[4/3] w-full object-cover', useCasePhotos[u.image].position]}
            />
            <div class="space-y-1 p-5">
              <h3 class="text-2xl leading-tight font-bold">{u.title}</h3>
              <p class="text-lg leading-snug">{u.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <div data-carousel-dots class="mt-3 flex justify-center gap-2 md:hidden" aria-hidden="true">
      {
        c.useCases.items.map((_, i) => (
          <span
            data-active={i === 0 ? 'true' : 'false'}
            class="h-2 w-2 rounded-full bg-azur/25 transition-all data-[active=true]:w-6 data-[active=true]:bg-azur"
          />
        ))
      }
    </div>
  </section>

  <!-- Audiences -->
  <section id="audiences" class="scroll-mt-20 bg-argile/50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <h2 class="text-4xl font-bold sm:text-5xl">{c.audiences.title}</h2>
      <p class="mt-3 max-w-2xl text-xl">{c.audiences.intro}</p>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          c.audiences.items.map((a) => (
            <li class="rounded-2xl bg-white p-6 shadow-sm">
              <h3 class="text-2xl font-bold text-azur">{a.title}</h3>
              <p class="mt-1 text-lg leading-snug">{a.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="mx-auto max-w-7xl scroll-mt-20 px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <h2 class="text-4xl font-bold sm:text-5xl">{c.howItWorks.title}</h2>
    <p class="mt-3 max-w-2xl text-xl">{c.howItWorks.intro}</p>
    <ol class="mt-10 grid gap-6 lg:grid-cols-3">
      {
        c.howItWorks.steps.map((s, i) => (
          <li class="rounded-3xl bg-mist p-7 ring-1 ring-argile">
            <p class="flex items-center gap-3 text-lg font-bold tracking-wide text-azur uppercase">
              <span class="flex size-9 items-center justify-center rounded-full bg-azur text-white">{i + 1}</span>
              {s.label}
            </p>
            <h3 class="mt-3 text-3xl font-bold">{s.title}</h3>
            <ul class="mt-4 space-y-2 text-lg leading-snug">
              {s.points.map((pt) => (
                <li class="flex gap-2">
                  <Icon name="check" class="mt-1 size-5 shrink-0 text-azur" />
                  {pt}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Download -->
  <DownloadCta locale={locale} id="download" title={c.download.title} text={c.download.text} />
</BaseLayout>

<script>
  // Highlight the dot of the use-case card currently in view (mobile carousel).
  const list = document.querySelector<HTMLElement>('[data-carousel]');
  const dots = document.querySelectorAll<HTMLElement>('[data-carousel-dots] > span');
  if (list && dots.length) {
    const cards = Array.from(list.children);
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const index = cards.indexOf(entry.target);
          dots.forEach((dot, i) => (dot.dataset.active = String(i === index)));
        }
      },
      { root: list, threshold: 0.6 },
    );
    cards.forEach((card) => observer.observe(card));
  }
</script>
