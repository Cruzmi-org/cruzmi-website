---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import { htmlLang, locales, path, defaultLocale, type Locale, type RouteKey } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description?: string;
  /** Social preview image (1200×630 JPEG in public/og/). Defaults to /og/default.jpg. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}
const { locale, routeKey, title, description, image = '/og/default.jpg', imageAlt, noindex = false } = Astro.props;
const tr = t(locale);
const alternates = [
  ...locales.map((l) => ({ hreflang: htmlLang[l], href: path(l, routeKey) })),
  { hreflang: 'x-default', href: path(defaultLocale, routeKey) },
];
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description ?? tr('meta.defaultDescription')}
      image={image}
      imageAlt={imageAlt ?? tr('meta.defaultImageAlt')}
      url={path(locale, routeKey)}
      locale={locale}
      alternateLocales={locales.filter((l) => l !== locale)}
      alternates={alternates}
      noindex={noindex}
      siteName={tr('meta.siteName')}
    />

    <meta name="theme-color" content="#005e93" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-lg bg-azur px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {tr('a11y.skip')}
    </a>
    <Header locale={locale} routeKey={routeKey} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
